{
	"name": "KAFAK_STREAM_PL",
	"properties": {
		"activities": [
			{
				"name": "KAFKA_GM_SRC",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "KAFKA_RAW_FOLDER",
						"type": "DatasetReference",
						"parameters": {
							"p_container": {
								"value": "@pipeline().parameters.p_container",
								"type": "Expression"
							},
							"p_folder": {
								"value": "@pipeline().parameters.p_folder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "KAFKA_FE_FILES",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "KAFKA_GM_SRC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('KAFKA_GM_SRC').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "LK_GET_KAFKA_CONFIG",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": "SELECT [file_name]\n      ,[kafka_topic]\n      ,[active_flag]\n  FROM [dbo].[kafka_file_config]\n  where file_name='@{item().name}'\n",
									"queryTimeout": "02:00:00",
									"isolationLevel": "ReadCommitted",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_SQL_CONFIG",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Web1",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "LK_GET_KAFKA_CONFIG",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"headers": {
									"undefined": "Name: Content-Type\nValue: application/json"
								},
								"url": "@pipeline().parameters.p_function_url",
								"body": {
									"container": "@{pipeline().parameters.p_container}",
									"folder": "@{pipeline().parameters.p_folder}",
									"fileName": "@{item().name}",
									"topic": "@{activity('LK_GET_KAFKA_CONFIG').output.firstRow.kafka_topic}"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_function_url": {
				"type": "string",
				"defaultValue": "https://publishtokafka-byfjhghhgkaacxdb.centralindia-01.azurewebsites.net/api/PublishToKafka?code=Z22PQRm11TA7a5LfZtcMl4CYDNZGNrOZy6ujE8TiId98AzFuDuaQMA="
			},
			"p_container": {
				"type": "string",
				"defaultValue": "raw"
			},
			"p_folder": {
				"type": "string",
				"defaultValue": "DATABASE_A"
			}
		},
		"annotations": []
	}
}